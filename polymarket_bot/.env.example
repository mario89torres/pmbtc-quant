# Polymarket Trading Bot - Environment Configuration

# ------------------------------------------------------------------------------
# SECURITY WARNING: Never commit your actual .env file or share your private key.
# Rename this file to .env and fill in the values below.
# ------------------------------------------------------------------------------

# 1. Trading Wallet Configuration
# Polygon wallet private key (64 hex characters, with or without 0x prefix)
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here

# Funder address (required if using proxy wallet like Magic or custom contract, otherwise same as key address)
POLYMARKET_FUNDER_ADDRESS=your_polygon_wallet_address_here

# 2. Network Configurations
# Polygon RPC Node URL (for balance checks). Public RPCs can be rate-limited.
POLYGON_RPC_URL=https://polygon-rpc.com

# 3. Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
